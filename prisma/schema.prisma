generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

// Per-shop, per-month counter of metered file operations (fresh duplicate-scan
// hashes + bulk renames) used to enforce plan quotas. `period` is "YYYY-MM"; a
// new row is created each month so usage resets.
model UsageCounter {
  id        String @id @default(cuid())
  shop      String
  period    String // "2026-06"
  filesUsed Int    @default(0)

  @@unique([shop, period])
}

// SHA-256 content hash of a file on the Shopify CDN, keyed by its URL.
//
// Duplicate detection needs the actual bytes, which means a download per file.
// Shopify CDN urls carry a ?v=<version> that changes whenever the file changes,
// so the url is a safe content key: a cached entry can never describe different
// bytes than the ones it was hashed from, and stale rows are simply never read
// again. Keyed by url with no shop column — a hash carries no identity beyond
// "some file had these bytes".
model FileHash {
  url       String   @id
  hash      String
  bytes     Int
  createdAt DateTime @default(now())
}
